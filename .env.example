NEXT_PUBLIC_API_URL=backend_api
# CARTO Basemaps browser key. Restrict it to the VegCom domains in CARTO.
NEXT_PUBLIC_CARTO_BASEMAPS_API_KEY=your_carto_basemaps_api_key_here
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here

# Resend – email delivery for the Feedback form
# 1. Create a free account at https://resend.com
# 2. Verify your sending domain (e.g. vegcomlife.com)
# 3. Paste your API key below
# 4. Update the `from` address in app/api/feedback/route.ts to match your verified domain
RESEND_API_KEY=re_your_api_key_here
